# =============================================================================================
# Plantilla de credenciales para docker-compose.yml. Este archivo SI se versiona; no pongas aqui
# valores reales.
#
#   Ubuntu (EC2):  cp .env.example .env && chmod 600 .env && nano .env
#   Windows:       Copy-Item .env.example .env   (y editarlo; guardarlo con finales de linea LF)
#
# .env vive junto a docker-compose.yml, lo ignoran Git (.gitignore) y Docker (.dockerignore).
#
# Reglas para los valores (evitan fallos de autenticacion dificiles de diagnosticar):
#   - Solo letras, numeros, "-" y "_" (recomendado: 32 caracteres aleatorios).
#   - Sin "$" (compose lo interpreta como variable), sin "#", comillas ni espacios.
#   - Finales de linea LF: un .env con CRLF anade "\r" al final de la contrasena.
#
# IMPORTANTE: cambiar un valor aqui NO cambia la contrasena de un PostgreSQL o RabbitMQ que ya
# tiene datos; primero se cambia dentro del servicio (ver docs/despliegue-aws.md, "Credenciales").
# =============================================================================================

# PostgreSQL: usuario "ecommerce". La usan postgres-db (POSTGRES_PASSWORD) y order-api (DB_PASSWORD).
POSTGRES_PASSWORD=

# RabbitMQ: usuario "ecommerce" (AMQP y consola 15672). La usan rabbitmq (RABBITMQ_DEFAULT_PASS),
# order-processor y los tres workers (SPRING_RABBITMQ_PASSWORD).
RABBITMQ_PASSWORD=
